LOG_LEVEL=DEBUG

# Puerto en el que escucha este módulo (debe coincidir con KERNEL_MEMORY_PORT en todos los otros configs)
KERNEL_MEMORY_PORT=23841

# Algoritmo de selección de huecos: BEST_FIT o WORST_FIT
SEGMENT_MAX_SIZE=128
ALLOCATION_STRATEGY=WORST
INSTRUCTION_DELAY=500
COMPACTION_DELAY=30000



# Carpeta donde están los archivos .prc (relativa o absoluta)
SCRIPTS_BASEPATH=/home/utnso/plug-n-pray-pruebas/