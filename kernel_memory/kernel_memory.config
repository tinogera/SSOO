LOG_LEVEL=INFO

# Puerto en el que escucha este módulo (debe coincidir con KERNEL_MEMORY_PORT en todos los otros configs)
KERNEL_MEMORY_PORT=23841

# Algoritmo de selección de huecos: BEST_FIT o WORST_FIT
ALLOCATION_STRATEGY=BEST_FIT

# Tamaño máximo de segmento en bytes (debe ser igual en KM y en todas las CPUs)
SEGMENT_MAX_SIZE=128

# Retardo en ms antes de responder un FETCH de instrucción
INSTRUCTION_DELAY=0

# Retardo en ms que dura la compactación
COMPACTION_DELAY=0

# Carpeta donde están los archivos .prc (relativa o absoluta)
SCRIPTS_BASEPATH=/home/utnso/pruebas
