LOG_LEVEL=DEBUG

# Prueba Memoria oficial — Memory Stick 1 (16 bytes)
# Se conecta PRIMERO -> el Kernel Memory le asigna id_memory_stick = 0
# (tiene que coincidir con IP/PUERTO_MEMORY_STICK_0 en cpu/PruebaMem/cpu.config)

# IP y puerto de la máquina donde corre Kernel Memory
KERNEL_MEMORY_IP=127.0.0.1
KERNEL_MEMORY_PORT=23841

# Puerto en el que este Memory Stick escucha conexiones de las CPUs
MEMORY_STICK_PORT=27643

# Retardo en ms antes de responder una lectura o escritura
MEMORY_DELAY=1500

# El tamaño (16 bytes) NO va en el config: se pasa como argumento al lanzarlo.
# ./bin/memory_stick PruebaMem/msPruebaMem.config 16
