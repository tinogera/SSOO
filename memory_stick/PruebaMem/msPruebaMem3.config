LOG_LEVEL=DEBUG

# Prueba Memoria oficial — Memory Stick 3 (64 bytes)
# Se conecta TERCERO -> el Kernel Memory le asigna id_memory_stick = 2
# (tiene que coincidir con IP/PUERTO_MEMORY_STICK_2 en cpu/PruebaMem/cpu.config)

# IP y puerto de la máquina donde corre Kernel Memory
KERNEL_MEMORY_IP=127.0.0.1
KERNEL_MEMORY_PORT=23841

# Puerto en el que este Memory Stick escucha conexiones de las CPUs
MEMORY_STICK_PORT=27645

# Retardo en ms antes de responder una lectura o escritura
MEMORY_DELAY=1500

# El tamaño (64 bytes) NO va en el config: se pasa como argumento al lanzarlo.
# ./bin/memory_stick PruebaMem/msPruebaMem3.config 64
