LOG_LEVEL=INFO

# IP y puerto de la máquina donde corre Kernel Memory
KERNEL_MEMORY_IP=127.0.0.1
KERNEL_MEMORY_PORT=23841

# Puerto en el que este Kernel Scheduler escucha (CPUs e IOs se conectan acá)
KERNEL_SCHEDULER_PORT=19337

# Algoritmo de planificación de corto plazo: FIFO, RR o CMN
PLANIFICATION_ALGORITHM=FIFO

# Quantum en ms (solo aplica si PLANIFICATION_ALGORITHM=RR o CMN con colas RR)
RR_QUANTUM=1500

# Para CMN: lista de algoritmos por cola de prioridad (índice 0 = mayor prioridad)
# QUEUES_ALGORITHMS=[FIFO,RR,RR,FIFO]

# Para CMN: habilitar desalojo entre colas (TRUE o FALSE)
# QUEUE_PREEMPTION=TRUE

# Tiempo en ms antes de suspender un proceso bloqueado en IO
SUSPENSION_TIMEOUT=35000
