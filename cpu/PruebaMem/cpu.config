LOG_LEVEL=DEBUG

# Prueba Memoria oficial — CPU conectada a KS, KM y a los 4 Memory Sticks de la prueba

# IP y puerto de la máquina donde corre Kernel Scheduler
IP_KERNEL=127.0.0.1
PUERTO_KERNEL=19337

# IP y puerto de la máquina donde corre Kernel Memory
IP_MEMORY=127.0.0.1
PUERTO_MEMORY=23841

# Tamaño máximo de segmento (debe coincidir con SEGMENT_MAX_SIZE en KM)
SEGMENT_MAX_SIZE=128

# Memory Sticks de la prueba: el índice (_0, _1, ...) tiene que coincidir con
# el ORDEN en que se conectaron al KM, es decir:
#   _0 -> msPruebaMem.config  (16 bytes, puerto 27643)
#   _1 -> msPruebaMem2.config (32 bytes, puerto 27644)
#   _2 -> msPruebaMem3.config (64 bytes, puerto 27645)
#   _3 -> msPruebaMem4.config (128 bytes, puerto 27646)
IP_MEMORY_STICK_0=127.0.0.1
PUERTO_MEMORY_STICK_0=27643
IP_MEMORY_STICK_1=127.0.0.1
PUERTO_MEMORY_STICK_1=27644
IP_MEMORY_STICK_2=127.0.0.1
PUERTO_MEMORY_STICK_2=27645
IP_MEMORY_STICK_3=127.0.0.1
PUERTO_MEMORY_STICK_3=27646
